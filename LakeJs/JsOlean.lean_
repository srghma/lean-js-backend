module

public import Lean
public import Lean.Compiler.LCNF
public import LakeJs.Output
public import LakeJs.RecFamilyOfEnv

@[expose] public section

/-!
# Reading the compiler's own `.olean` files

The backend does not re-elaborate anything: it reads what Lean already stored in the
`.olean` files of the modules it is given.  What it reads is the **`saveBase` LCNF
phase**:

* not the `mono` phase, and not `Lean.IR`, because both of those have already thrown
  the types away — `Nat`, `UInt32`, `Char` and a one-field structure all look alike
  by then;
* `base` still has the LCNF type of every binder and every declaration, which is
  what lets this backend pick a JavaScript representation per Lean type (see
  `LakeJs.JsPrims`) and then optimise against it.

`loadJsOlean` is the whole of the IO the compiler does.  It imports the modules,
walks the call graph of the requested roots through `getBaseDecl?`, and copies
everything the translation will need — the declarations, the constructors, and which
structures Lean represents by their single field — into a plain `JsOleanData` value,
so that the translation itself is a pure function.
-/

namespace Lean.Compiler.JS

open Lean.Compiler.LCNF

/-- What the backend needs to know about a constructor. -/
structure JsCtorInfo where
  /-- The constructor's name, which is also its runtime tag. -/
  name : Name
  /-- The inductive type it belongs to. -/
  induct : Name
  /-- Its index among the constructors of that type. -/
  cidx : Nat
  /-- The number of parameters of the type, which precede the fields. -/
  numParams : Nat
  /-- The number of fields. -/
  numFields : Nat
  /-- Its runtime tag, as `LakeJs.RecFamilyOfEnv` writes it: the short name of the
      constructor, prefixed by its type for a mutual family. -/
  tag : String
  /-- The names its fields were declared with, in order — the field names of a
      structure, the binder names of the constructor otherwise.  This is what
      `JsFieldNaming.declared` prints. -/
  fieldNames : Array Name := #[]
  deriving Inhabited, Repr

/-- What the backend needs to know about an inductive type. -/
structure JsTypeInfo where
  /-- The type's name. -/
  name : Name
  /-- Its constructors, in declaration order. -/
  ctors : Array Name
  /-- Whether it is recursive. -/
  isRec : Bool
  /-- When the type is a *trivial structure* — one constructor with one
      computationally relevant field — the index of that field.  Lean represents
      such a value by the field itself (this is why a `Char` is a number), and so
      does this backend. -/
  trivialFieldIdx? : Option Nat
  deriving Inhabited, Repr

/-- Everything read out of the `.olean` files, as plain data. -/
structure JsOleanData where
  /-- The `saveBase` LCNF declarations, by name. -/
  decls : Std.HashMap Name Decl := {}
  /-- The constructors mentioned by those declarations. -/
  ctors : Std.HashMap Name JsCtorInfo := {}
  /-- The inductive types mentioned by those declarations. -/
  types : Std.HashMap Name JsTypeInfo := {}
  /-- The recursion-aware schema of each of those types, where one could be read
      off the environment.  This is what a compiled constructor and a `cases` are
      translated against: `Expr.leanEnum` and `Expr.foldEnum` are indexed by it. -/
  families : Std.HashMap Name LeanRecFamily := {}
  /-- For each module that was asked for, its public declarations, in source
      order.  This is what an output file exports when no list is given. -/
  modulePublicDecls : Array (Name × Array Name) := #[]
  /-- The declarations Lean did **not** prove terminating and that belong to the
      modules being compiled: a `partial def` the source contains, one of its
      `where`/`let rec` helpers, or a specialization of one.

      Not every `unsafe` LCNF declaration is in here, and that is the point.  Lean's
      own `Init` implements a *proved terminating* function such as `Array.mapM` by an
      `unsafe` loop (`Array.mapMUnsafe.map`) and hands the backend a specialization of
      that loop, so `safe = false` on its own would refuse `(a.map f).filter g`.  What
      is refused (`EXPR-DROP-LAM-CALL-PLAN.md` §2.0) is a declaration *of the module
      being compiled* that Lean did not prove terminating; an `unsafe` implementation
      that Lean itself chose for a total library function is accepted, because the
      declaration the user wrote does have a termination proof. -/
  localUnsafe : Std.HashSet Name := {}
  deriving Inhabited

/-- The names the fields of a constructor were declared with: the binder names of
    its type, after the `numParams` parameters of the inductive. -/
partial def ctorFieldNames (numParams : Nat) (type : Expr) : Array Name :=
  go type numParams #[]
where
  go (e : Expr) (skip : Nat) (acc : Array Name) : Array Name :=
    match e with
    | .forallE nm _ body _ =>
      if skip > 0 then go body (skip - 1) acc else go body 0 (acc.push nm)
    | _ => acc

/-- Where a compiler-generated specialization comes from: `A._at_.B.spec_0` is a
    specialization of `A`, and a name with no `_at_` component is its own origin.
    This is what says whether an `unsafe` declaration is the user's or Lean's: the
    specialization lives in the module being compiled, but its origin does not. -/
def specializationOrigin (n : Name) : Name :=
  let cs := n.components
  match cs.findIdx? (· == `_at_) with
  | some i => (cs.take i).foldl (· ++ ·) Name.anonymous
  | none => n

/-- Is `suffix` a suffix of `full`, component by component?  `test2` is a suffix of
    `SnapshotsPBO.CaseRecord.Test2.test2`, but not of `mytest2`. -/
def isNameSuffix (suffix full : Name) : Bool :=
  suffix.components.isSuffixOf full.components

namespace JsOleanData

/-- The public declarations of all the modules that were read, in order. -/
def allPublicDecls (d : JsOleanData) : Array Name :=
  d.modulePublicDecls.flatMap (·.2)

/-- Resolve a name as it was written by the user: either it is the full name of a
    declaration that was loaded, or it is a declaration of one of the modules —
    possibly in a namespace of it, as long as that leaves no ambiguity, so that
    `test2` finds `Test2.test2`. -/
def resolve? (d : JsOleanData) (n : Name) : Option Name :=
  if d.decls.contains n then some n
  else match d.modulePublicDecls.findSome? fun (m, _) =>
      if d.decls.contains (m ++ n) then some (m ++ n) else none with
    | some n' => some n'
    | none =>
      let candidates := d.modulePublicDecls.flatMap fun (_, ns) =>
        ns.filter (isNameSuffix n)
      if candidates.size == 1 then candidates[0]? else none

end JsOleanData

/-- The constants a piece of LCNF code refers to, together with the types it
    projects out of or does `cases` on. -/
partial def collectRefs (code : Code) (consts : NameSet) (types : NameSet) :
    NameSet × NameSet :=
  match code with
  | .let decl k =>
    let (consts, types) :=
      match decl.value with
      | .const declName .. => (consts.insert declName, types)
      | .proj typeName .. => (consts, types.insert typeName)
      | _ => (consts, types)
    collectRefs k consts types
  | .fun decl k | .jp decl k =>
    let (consts, types) := collectRefs decl.value consts types
    collectRefs k consts types
  | .cases c =>
    c.alts.foldl (init := (consts, types.insert c.typeName)) fun (consts, types) alt =>
      match alt with
      | .default k => collectRefs k consts types
      | .alt _ _ k => collectRefs k consts types
  | _ => (consts, types)

/-- The constants and types a declaration refers to. -/
def declRefs (d : Decl) : NameSet × NameSet :=
  match d.value with
  | .code c => collectRefs c {} {}
  | _ => ({}, {})

/-- Is `n` a declaration a user would expect to see exported from their module? -/
def isPublicDecl (env : Environment) (n : Name) : Bool :=
  !n.isInternal && !isPrivateName n && !n.hasMacroScopes &&
    match env.find? n with
    | some (.defnInfo _) => true
    | some (.opaqueInfo _) => true
    | _ => false

/-- The public declarations of `mod`, in the order they appear in the module. -/
def modulePublicDecls (env : Environment) (mod : Name) : Array Name := Id.run do
  let some idx := env.getModuleIdx? mod | return #[]
  let some data := env.header.moduleData[idx.toNat]? | return #[]
  let mut out := #[]
  for n in data.constNames do
    if isPublicDecl env n then
      out := out.push n
  return out

/-- Resolve a name the user wrote on the command line: either it is a constant on
    its own, or it is a declaration of one of the modules being compiled — possibly
    in a namespace of it, as long as that leaves no ambiguity. -/
def resolveRoot? (env : Environment) (modules : Array Name) (n : Name) : Option Name :=
  if env.contains n then some n
  else match modules.findSome? fun m =>
      if env.contains (m ++ n) then some (m ++ n) else none with
    | some n' => some n'
    | none =>
      let candidates := modules.flatMap fun m =>
        (modulePublicDecls env m).filter (isNameSuffix n)
      if candidates.size == 1 then candidates[0]? else none

/--
Read the `.olean` files: import `modules`, then collect the `saveBase` LCNF of
everything the given outputs can reach, plus the information about constructors and
structures the translation needs.
-/
def loadJsOlean (modules : Array Name) (contents : Array OutputContent) :
    IO JsOleanData := do
  if modules.isEmpty then return {}
  initSearchPath (← findSysroot)
  let env ← importModules (modules.map fun m => { module := m }) {} (trustLevel := 1024)
  let publics := modules.map fun m => (m, modulePublicDecls env m)
  let requested := contents.flatMap (·.roots)
  let mut roots : Array Name := #[]
  for n in requested do
    match resolveRoot? env modules n with
    | some n' => roots := roots.push n'
    | none => throw <| IO.userError s!"unknown declaration '{n}'"
  for (_, ns) in publics do
    for n in ns do
      if !roots.contains n then roots := roots.push n
  let act : CoreM JsOleanData := do
    let mut todo := roots.toList
    let mut decls : Std.HashMap Name Decl := {}
    let mut typeNames : NameSet := {}
    while !todo.isEmpty do
      let n := todo.head!
      todo := todo.tail!
      if decls.contains n then continue
      let some d ← getBaseDecl? n | continue
      decls := decls.insert n d
      let (consts, types) := declRefs d
      for t in types do
        typeNames := typeNames.insert t
      for c in consts do
        if decls.contains c then continue
        match (← getEnv).find? c with
        | some (.ctorInfo ci) => typeNames := typeNames.insert ci.induct
        | _ => todo := c :: todo
    let mut ctors : Std.HashMap Name JsCtorInfo := {}
    let mut types : Std.HashMap Name JsTypeInfo := {}
    let mut families : Std.HashMap Name LeanRecFamily := {}
    for t in typeNames do
      let some (.inductInfo ii) := (← getEnv).find? t | continue
      let trivial? ← hasTrivialStructure? t
      types := types.insert t
        { name := t, ctors := ii.ctors.toArray, isRec := ii.isRec
          trivialFieldIdx? := trivial?.map (·.fieldIdx) }
      -- A type whose schema cannot be read off the environment is simply left out:
      -- the translation then reports it as unsupported instead of guessing.
      match ← (try some <$> Meta.MetaM.run' (extractRecFamily t) catch _ => pure none) with
      | some fam => families := families.insert t fam
      | none => pure ()
      let multi := ii.all.length > 1
      for (c, i) in ii.ctors.zipIdx do
        let some (.ctorInfo ci) := (← getEnv).find? c | continue
        ctors := ctors.insert c
          { name := c, induct := t, cidx := i, numParams := ci.numParams
            numFields := ci.numFields, tag := recFamilyTag multi t c
            fieldNames := ctorFieldNames ci.numParams ci.type }
    -- A module's public declarations are reported as the ones that *can* be
    -- compiled: a name Lean generates alongside a declaration (`Rec.mk.noConfusion`,
    -- `TestEnum.ctorElimType`, a `match_1` auxiliary) has no `saveBase` body, so it
    -- is not something an output file can export.
    let publics := publics.map fun (m, ns) => (m, ns.filter decls.contains)
    -- Which of the `unsafe` declarations are the *module's own* (see `localUnsafe`).
    let env ← getEnv
    let mut localUnsafe : Std.HashSet Name := {}
    for (n, dcl) in decls do
      if !dcl.safe then
        let origin := specializationOrigin n
        let ownModule :=
          match env.getModuleIdxFor? origin with
          | some i => (env.header.moduleNames[i.toNat]?).map modules.contains |>.getD true
          | none => true
        if ownModule then localUnsafe := localUnsafe.insert n
    return { decls, ctors, types, families, modulePublicDecls := publics, localUnsafe }
  let (res, _) ← act.toIO { fileName := "<lakejs>", fileMap := default } { env }
  return res

end Lean.Compiler.JS

end
