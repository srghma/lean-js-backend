module

public import LakeJs.Subst
public import LakeJs.Render
public import LakeJs.JSString

@[expose] public section

-- `js`, the label context, is auto-bound per declaration: the traversals below
-- recurse into the continuation of a `jp`, which lives in a larger label context.

/-!
# The optimizer's core: types, constant folding, and the static checker

This module holds everything the optimizer of `LakeJs.Eval` needs *before* it
can evaluate anything:

* `JSTy` — the JavaScript type of an expression, when it is statically known — and
  the two oracles `Expr.knownTy` (the type read off the head of a term) and
  `Expr.checkTy` (the sharper one used by the checker);
* the constant-folding rules `foldBinop`, `foldUnary`, `foldCmp`, `truthy`, which
  the optimizer falls back on for operands that are not values;
* `OptError`, the errors the optimizer reports, and `Expr.check`, the static pass
  that looks for them in a *residual* program.

It is split out of `LakeJs.Eval` only because the value layer
(`LakeJs.JSVal`) sits between the two: the optimizer is an engine, so it needs
the JavaScript semantics of values, and those in turn are phrased in terms of `JSTy`
and `OptError`.
-/
/-! ## Statically known JavaScript types -/

/-- The JavaScript type of an `Expr`, when it is statically known. -/
inductive JSTy where
  | number | string | boolean | array | object | undefined | null
  /-- A `BigInt`: a JavaScript type of its own, never mixed with `number`. -/
  | bigint
  /-- An object produced by a compiled Lean constructor: `{ tag: …, _1: … }`. -/
  | leanEnum
  deriving Repr, DecidableEq, BEq, Inhabited

def JSTy.describe : JSTy → String
  | .number => "a number" | .bigint => "a bigint"
  | .string => "a string" | .boolean => "a boolean"
  | .array => "an array"  | .object => "an object"
  | .undefined => "undefined" | .null => "null"
  | .leanEnum => "a Lean constructor object"

/-- The `typeof` of a statically known type. -/
def JSTy.typeofString : JSTy → String
  | .number => "number" | .bigint => "bigint"
  | .string => "string" | .boolean => "boolean"
  | .array | .object | .leanEnum | .null => "object"
  | .undefined => "undefined"

/-- Can a value of this type appear after `...` in an array literal?  In JavaScript
    the spread of an array literal iterates its argument, so arrays and strings are
    fine and everything else throws.  Plain objects are *not* iterable (only
    object spread inside `{…}` is), and neither are compiled constructor objects. -/
def JSTy.isIterable : JSTy → Bool
  | .array | .string => true
  | _                => false

def Expr.knownTy : Expr n js g → Option JSTy
  | .numLit _   => some .number
  | .bigintLit _ => some .bigint
  | .str _      => some .string
  | .bexpr _    => some .boolean
  | .arr _      => some .array
  -- An object literal whose keys are not all static may be *stuck* — a spread of an
  -- opaque value contributes keys nobody knows — so its type is not known either.
  | .obj ps     => if ps.isStatic then some .object else none
  | .leanEnum _ => some .leanEnum
  | .undefined  => some .undefined
  | .null       => some .null
  | _           => none

/-! ## Constant folding -/

def ofBool : Bool → BExpr n js g
  | true  => .tt
  | false => .ff

/-- The truthiness of a value, when it is statically known. -/
def truthy {m : Nat} : Expr m js g → BExpr m js g
  | .str v      => ofBool (v != "")
  | .undefined  => .ff
  | .null       => .ff
  | .arr _      => .tt
  | .obj ps     => if ps.isStatic then .tt else .truthy (.obj ps)
  | .leanEnum _ => .tt
  | .bexpr b    => b
  | e           => .truthy e

/-- Emit a number as an expression — **when it may be emitted at all**.  The number
    becomes a numeric literal, but only if it has a JavaScript literal within the
    size bound (`JSNumber.toLiteral?`).  A fold whose result has none — `1 / 3`, or a
    literal past the length bound — answers `none`, and the engine keeps the
    operation in the residual program.  That is the output-size discipline: repeated
    folding of divisions cannot grow a denominator without bound. -/
def JSNumber.toExpr? {n : Nat} (x : JSNumber) : Option (Expr n js g) :=
  if (JSNumber.emit? x).isSome then some (.numLit x) else none

/-- An integer is always emittable, so a length, an index or a count never blocks a
    fold. -/
@[simp] theorem JSNumber.toExpr?_ofNat {n : Nat} (k : Nat) :
    (JSNumber.toExpr? (JSNumber.ofNat k) : Option (Expr n js g)) = some (.num k) := by
  simp [JSNumber.toExpr?, Expr.num]

@[simp] theorem JSNumber.toExpr?_ofInt {n : Nat} (i : Int) :
    (JSNumber.toExpr? (JSNumber.ofInt i) : Option (Expr n js g)) = some (.numLit (.ofInt i)) := by
  simp [JSNumber.toExpr?]

/-- The numeric meaning of a binary operator, when it has one: exactly the
    arithmetic, bitwise and shift operators, computed in the one exact model of
    `LakeJs.JSNumber`.  `none` for `??` and for the string primitives, which are not
    arithmetic at all. -/
def BinOp.onNumbers? (op : BinOp) (x y : JSNumber) : Option JSNumber :=
  match op with
  | .plus   => some (x.add y)
  | .minus  => some (x.sub y)
  | .times  => some (x.mul y)
  -- `**` has an answer only where the exact model does: an integer exponent within
  -- the bound.  `2 ** 0.5` is `none` — a residual, not an error.
  | .pow    => JSNumber.pow? x y
  | .mathMin => some (JSNumber.min x y)
  | .mathMax => some (JSNumber.max x y)
  | .divide => some (x.div y)
  | .mod    => some (x.mod y)
  | .bitAnd => some (x.band y)
  | .bitOr  => some (x.bor y)
  | .bitXor => some (x.bxor y)
  | .lsh    => some (x.shl y)
  | .rsh    => some (x.shr y)
  | .ursh   => some (x.ushr y)
  | .nullish | .strSplit | .strIndexOf | .strLastIndexOf | .strSliceFrom
  | .strCharAt | .strAt | .strCodePointAt => none

/-- The bigint meaning of a binary operator, when it has one — the mirror of
    `BinOp.onNumbers?`, computed in `LakeJs.JSBigInt`.  `none` where JavaScript
    throws (`1n / 0n`, and `>>>`, which bigints do not have) or where the result is
    past the bound this backend folds, and `none` for the operators that are not
    arithmetic at all. -/
def BinOp.onBigints? (op : BinOp) (i j : Int) : Option Int :=
  match op with
  | .plus   => some (JSBigInt.add i j)
  | .minus  => some (JSBigInt.sub i j)
  | .times  => some (JSBigInt.mul i j)
  -- `2n ** -1n` throws in JavaScript, and an exponent past the bound is a limitation
  -- of this backend; both are `none`.
  | .pow    => JSBigInt.pow? i j
  -- `Math.min`/`Math.max` of a bigint is a `TypeError` in JavaScript.
  | .mathMin | .mathMax => none
  | .divide => JSBigInt.div? i j
  | .mod    => JSBigInt.mod? i j
  | .bitAnd => some (JSBigInt.band i j)
  | .bitOr  => some (JSBigInt.bor i j)
  | .bitXor => some (JSBigInt.bxor i j)
  | .lsh    => JSBigInt.shl? i j
  | .rsh    => JSBigInt.shr? i j
  | .ursh   => none
  | .nullish | .strSplit | .strIndexOf | .strLastIndexOf | .strSliceFrom
  | .strCharAt | .strAt | .strCodePointAt => none

/-- Constant folding of the non-boolean binary operators.  Every arithmetic operation
    of `JSNumber` is total and exact, so — unlike the `Nat` rules this replaces — no
    side condition is needed: `1 - 2` folds to `-1`, `7 / 2` to `3.5`, `1 / 0` to
    `Infinity`.  The one reason not to fold is that the answer has no literal within
    the size bound (`JSNumber.toExpr?`), which is what stops a denominator from
    growing without bound under repeated folding. -/
def foldBinop {m : Nat} (op : BinOp) (a b : Expr m js g) : Expr m js g :=
  match a, b with
  | .str x, .str y =>
      match op with
      | .plus => .str (x ++ y)
      | _     => .binop op a b
  | .numLit x, .numLit y =>
      match op.onNumbers? x y with
      | some r => (JSNumber.toExpr? r).getD (.binop op a b)
      | none   => .binop op a b
  -- Two bigints: exact integer arithmetic, with no size guard — an integer always
  -- has a literal.  A bigint *mixed* with anything else is a `TypeError`, and is
  -- deliberately not folded.
  | .bigintLit x, .bigintLit y =>
      match op.onBigints? x y with
      | some r => .bigintLit r
      | none   => .binop op a b
  | _, _ => .binop op a b

/-- Constant folding of the unary operators.  On a numeric literal the three numeric
    operators are total, and folded subject to the same output-size guard. -/
def foldUnary {m : Nat} (op : UnOp) (a : Expr m js g) : Expr m js g :=
  match op, a with
  | .typeof, a => match a.knownTy with
                  | some ty => .str ty.typeofString
                  | none    => .unary .typeof a
  | .plus,   .numLit x => .numLit x
  | .mathFloor, .numLit x =>
      (JSNumber.toExpr? (JSNumber.floor x)).getD (.unary .mathFloor (.numLit x))
  | .mathCeil,  .numLit x =>
      (JSNumber.toExpr? (JSNumber.ceil x)).getD (.unary .mathCeil (.numLit x))
  | .mathTrunc, .numLit x =>
      (JSNumber.toExpr? (JSNumber.trunc x)).getD (.unary .mathTrunc (.numLit x))
  | .mathRound, .numLit x =>
      (JSNumber.toExpr? (JSNumber.round x)).getD (.unary .mathRound (.numLit x))
  | .mathAbs,   .numLit x =>
      (JSNumber.toExpr? (JSNumber.abs x)).getD (.unary .mathAbs (.numLit x))
  | .mathSign,  .numLit x =>
      (JSNumber.toExpr? (JSNumber.sign x)).getD (.unary .mathSign (.numLit x))
  | .minus,  .numLit x => (JSNumber.toExpr? x.neg).getD (.unary .minus (.numLit x))
  | .tilde,  .numLit x => (JSNumber.toExpr? x.bnot).getD (.unary .tilde (.numLit x))
  -- `-1n` and `~1n` are bigints; `+1n` is a `TypeError`, and so is not folded.
  | .minus,  .bigintLit x => .bigintLit (JSBigInt.neg x)
  | .tilde,  .bigintLit x => .bigintLit (JSBigInt.bnot x)
  | op,      a      => .unary op a

/-- Constant folding of the comparisons. -/
def foldCmp {m : Nat} (op : BinOpBool) (a b : Expr m js g) : BExpr m js g :=
  match a, b with
  | .numLit x, .numLit y =>
      match op with
      | .lt => ofBool (JSNumber.lt x y) | .le => ofBool (JSNumber.le x y)
      | .gt => ofBool (JSNumber.gt x y) | .ge => ofBool (JSNumber.ge x y)
      | .eq | .strictEq   => ofBool (JSNumber.strictEq x y)
      | .neq | .strictNeq => ofBool (!JSNumber.strictEq x y)
      -- A string method applied to a number: not folded here, the engine reports it.
      | .strIncludes | .strStartsWith | .strEndsWith => .binop op a b
  -- Two bigints compare by value, and `1n === 1n` really is `true` — unlike the
  -- cross-type case, which the interpreter decides and this rule leaves alone.
  | .bigintLit x, .bigintLit y =>
      match op with
      | .lt => ofBool (decide (x < y)) | .le => ofBool (decide (x ≤ y))
      | .gt => ofBool (decide (y < x)) | .ge => ofBool (decide (y ≤ x))
      | .eq | .strictEq   => ofBool (x == y)
      | .neq | .strictNeq => ofBool (x != y)
      | .strIncludes | .strStartsWith | .strEndsWith => .binop op a b
  | .str x, .str y =>
      match op with
      | .eq | .strictEq   => ofBool (x == y)
      | .neq | .strictNeq => ofBool (x != y)
      | .strIncludes      => ofBool (JsStr.includes x y)
      | .strStartsWith    => ofBool (JsStr.startsWith x y)
      | .strEndsWith      => ofBool (JsStr.endsWith x y)
      | _                 => .binop op a b
  | _, _ => .binop op a b

/-! ## Static errors -/

/-- A sharper static type oracle than `Expr.knownTy`, used **only** by the checker.

    `knownTy` is also consumed by constant folding (`foldUnary`, `.isArray`,
    `.isTag`), where it has to agree with the deliberately lenient interpreter
    `Expr.run`: `run` leaves e.g. `1 - 2` *stuck* instead of producing a value, so
    `knownTy` must not claim it is a number.  The checker has no such obligation — it
    only has to be right about real JavaScript — so it can use the fact that the
    arithmetic, bitwise and shift operators always produce a number, that `typeof`
    always produces a string, and that `+` produces a string as soon as one side is
    one.  Every answer it gives is the type the expression has in JavaScript
    *whenever it has a value at all*. -/
def Expr.checkTy {n : Nat} : Expr n js g → Option JSTy
  | .numLit _   => some .number
  | .bigintLit _ => some .bigint
  | .str _      => some .string
  | .bexpr _    => some .boolean
  | .arr _      => some .array
  | .obj ps     => if ps.isStatic then some .object else none
  | .leanEnum _ => some .leanEnum
  | .undefined  => some .undefined
  | .null       => some .null
  | .unary op a =>
      match op with
      | .typeof                 => some .string
      -- Unary `+` throws on a bigint, so `number` is right wherever it has a value at
      -- all; `-` and `~` do **not** throw there, so they answer a bigint on a bigint
      -- and nothing at all on an operand whose type is unknown.
      | .plus                   => some .number
      -- The exact `Math.*` functions throw on a bigint and answer a number on
      -- everything else, so `number` is right wherever they have a value at all.
      | .mathFloor | .mathCeil | .mathTrunc | .mathRound | .mathAbs | .mathSign =>
          some .number
      | .minus | .tilde =>
          match Expr.checkTy a with
          | some .bigint => some .bigint
          | some _       => some .number
          | none         => none
      | .voidOp                 => some .undefined
      -- `x.toFixed(6)` is a string wherever it has a value at all.
      | .toFixed6               => some .string
      | .toStr | .strUpper | .strLower | .strTrim | .strTrimStart | .strTrimEnd =>
          some .string
      | .toBigInt                => some .bigint
      | .objKeys | .objValues | .objEntries       => some .array
  | .binop op a b =>
      match op with
      | .plus =>
          match Expr.checkTy a, Expr.checkTy b with
          | some .string, _ => some .string
          | _, some .string => some .string
          | some .number, some .number => some .number
          -- `1n + 1n` is a bigint; `1n + 1` throws, so *any* answer is vacuously
          -- right there, and `none` is the honest one.
          | some .bigint, some .bigint => some .bigint
          | _, _ => none
      | .strSplit                 => some .array
      | .strIndexOf | .strLastIndexOf => some .number
      | .strSliceFrom | .strCharAt => some .string
      -- `s.at(k)` is a string or `undefined`, and `s.codePointAt(k)` a number or
      -- `undefined`, so neither type is known statically.
      | .strAt | .strCodePointAt  => none
      -- `a ?? b` has the type of whichever side is taken, so it is known only when
      -- both sides agree — and `a` cannot be nullish, or the whole node would be `b`.
      | .nullish =>
          match Expr.checkTy a, Expr.checkTy b with
          | some ta, some tb => if ta == tb then some ta else none
          | _, _ => none
      -- The arithmetic, bitwise and shift operators produce a bigint on two bigints
      -- and a number otherwise.  Mixing the two types throws, so one known bigint
      -- operand is enough to answer `bigint`, and one known operand of any other type
      -- is enough to answer `number` — but two *unknown* operands are not enough for
      -- either, since they may both turn out to be bigints.
      | _ =>
          match Expr.checkTy a, Expr.checkTy b with
          | some .bigint, _ | _, some .bigint => some .bigint
          | none, none => none
          | _, _ => some .number
  | .cond _ t e =>
      match Expr.checkTy t, Expr.checkTy e with
      | some t₁, some t₂ => if t₁ == t₂ then some t₁ else none
      | _, _ => none
  -- `a.length` on an array and `s.length` on a string are numbers, and `c.tag` on a
  -- compiled constructor object is a string; every other property read may be
  -- `undefined`, so it decides nothing.
  | .prop o name =>
      match Expr.checkTy o with
      | some .array  => if name.val == "length" then some .number else none
      | some .string => if name.val == "length" then some .number else none
      | some .leanEnum => if name.val == "tag" then some .string else none
      | _ => none
  -- A fold's answer is the initial value when the array is empty and the body's answer
  -- otherwise, so the two have to agree — and then the answer is that type, whatever
  -- the array holds.  `Expr.checkTy` reads no environment, so the body's answer under
  -- the two extra bindings is the same question asked here.
  | .foldArray _ _ init body =>
      match Expr.checkTy init, Expr.checkTy body with
      | some t₁, some t₂ => if t₁ == t₂ then some t₁ else none
      | _, _ => none
  -- A `letIn` has the type of its body — exactly as precise, since `Expr.checkTy`
  -- reads no environment and the binding changes none of the answers it gives.
  | .letIn _ body => Expr.checkTy body
  -- `.index` and `.getField` stay `none` deliberately: an out-of-range read is
  -- `undefined`, so neither the element type nor the field type is the node's type.
  | _ => none
termination_by e => e.size
decreasing_by all_goals (simp only [Expr.size]; omega)

/-- A statically detectable error: code the optimizer knows will throw. -/
inductive OptError where
  /-- A fold over a value that is statically known not to be a compiled constructor. -/
  | foldOfNonValue (scrut : String) (ty : JSTy)
  /-- A fold over a constructor value of a *different* inductive family. -/
  | foldOfWrongFamily (scrut : String) (tag : String) (famName : String)
  /-- `reduce`/`reduceRight` over something statically known not to be an array. -/
  | foldOfNonArray (recv : String) (parens : Bool) (dir : String) (ty : JSTy)
  /-- Reading a property of `undefined` or `null`. -/
  | nullishProp (ty : JSTy) (name : String)
  /-- `[… ...e …]` where `e` is statically known not to be iterable. -/
  | spreadOfNonIterable (operand : String) (ty : JSTy)
  /-- Not broken code: a number this backend cannot *spell* (`1 / 3`), or a numeric
      spelling it cannot read (`1e3`, `0x10`).  Only the engine of `LakeJs.Eval`
      reports it, and `OptError.isLimitation` distinguishes it from a real error. -/
  | unsupportedNumber (what : String)
  /-- A property of an object literal this backend cannot *spell*: a computed key
      whose value is the empty string, or a spread of a value whose own keys are its
      indices (a string, an array) or the compiled shape of a constructor.  Like
      `unsupportedNumber`, not broken code — the program is fine, the representation
      of a key in this language is not — so `OptError.isLimitation` says so. -/
  | unsupportedObjProp (what : String)
  /-- A primitive method applied to a value it has no meaning for: `(1).toUpperCase()`,
      `Object.keys("s")`.  In JavaScript this is a `TypeError` (or, for a method the
      value simply does not have, a call of `undefined`). -/
  | methodOfWrongType (what : String)
  /-- A `BigInt` and a number mixed in one arithmetic operation, or a unary `+` applied
      to a `BigInt`.  In JavaScript this is a `TypeError`: the two numeric types never
      mix, whatever their values. -/
  | bigintMix (what : String)
  /-- A `BigInt` operation with no result: division or remainder by zero (a
      `RangeError`), a shift past the bound this model puts on shifts, or `>>>`, which
      `BigInt` does not have at all. -/
  | bigintNoValue (what : String)
  /-- A `RangeError` a real engine raises, carrying that engine's own message:
      `BigInt(1.5)` is *"The number 1.5 cannot be converted to a BigInt because it is
      not an integer"*.  It is the **program** that is wrong, so this is never a
      limitation (`EXPR-REDUCIBILITY.md` §4.1(d)). -/
  | rangeError (message : String)
  deriving Repr, DecidableEq, BEq, Inhabited

namespace OptError

def render : OptError → String
  | .foldOfNonValue scrut ty =>
      s!"cannot fold '{scrut}': it is {ty.describe}, not a Lean constructor object"
  | .foldOfWrongFamily scrut tag famName =>
      s!"cannot fold '{scrut}': its tag '{tag}' is not a constructor of {famName}"
  | .foldOfNonArray recv parens dir ty =>
      let r := if parens then "(" ++ recv ++ ")" else recv
      s!"'{r}.{dir}' is not a function ({recv} is {ty.describe})"
  | .nullishProp ty name =>
      s!"Cannot read properties of {ty.describe} (reading '{name}')"
  | .spreadOfNonIterable operand ty =>
      s!"'...{operand}' is not iterable ({operand} is {ty.describe})"
  | .unsupportedNumber what =>
      s!"cannot evaluate '{what}': the result is a number this backend cannot \
        write as a literal"
  | .unsupportedObjProp what =>
      s!"cannot evaluate '{what}': the key this property contributes is one this \
        backend cannot write in an object literal"
  | .methodOfWrongType what =>
      s!"cannot evaluate '{what}': the method does not apply to this value"
  | .bigintMix what =>
      s!"cannot evaluate '{what}': a BigInt and a number cannot be mixed"
  | .bigintNoValue what =>
      s!"cannot evaluate '{what}': the operation has no BigInt result"
  | .rangeError message => message

/-- Is this a limitation of the backend rather than a bug in the program?  A program
    reported only with limitations is legal JavaScript; the engine simply cannot
    compute its value. -/
def isLimitation : OptError → Bool
  | .unsupportedNumber _  => true
  | .unsupportedObjProp _ => true
  | _                     => false

/-- The error to report for an operator that has no answer on values: a *method* fails
    because the value is of the wrong type, an *operator* because the number it would
    produce is outside the exact fragment. -/
def ofOpFailure (isMethod : Bool) (what : String) : OptError :=
  if isMethod then .methodOfWrongType what else .unsupportedNumber what

/-- `BigInt(x)` of a number that is not an integer: the `RangeError` V8, SpiderMonkey
    and JavaScriptCore all raise, word for word. -/
def notAnIntegerBigInt (rendered : String) : OptError :=
  .rangeError s!"The number {rendered} cannot be converted to a BigInt because it is \
    not an integer"

/-- The error to report for an operator whose operands are `BigInt`s, or a `BigInt` and
    something else: a mix is a `TypeError` in the program, and two `BigInt`s with no
    answer are the `RangeError` cases.  Neither is a limitation of the backend, which is
    why they are not reported as `unsupportedNumber`. -/
def ofBigintFailure (isMethod : Bool) (ta tb : Option JSTy) (what : String) : OptError :=
  if isMethod then .methodOfWrongType what
  else
    match ta, tb with
    | some .bigint, some .bigint => .bigintNoValue what
    | some .bigint, _ | _, some .bigint => .bigintMix what
    | _, _ => .unsupportedNumber what

instance : ToString OptError := ⟨render⟩

/-- Render a batch of errors, one per line, in the order they were found. -/
def renderAll (es : List OptError) : String :=
  String.intercalate "\n" (es.map render)

end OptError

/-! ## Which opcodes are primitive methods

The operator tables of `LakeJs.Expr` hold both JavaScript *operators* and the
first-order *primitive methods*.  The two fail for different reasons, and the engine
reports them differently. -/

/-- Is this unary opcode a primitive method rather than an operator? -/
def UnOp.isPrimMethod : UnOp → Bool
  | .toStr | .strUpper | .strLower | .strTrim | .strTrimStart | .strTrimEnd
  | .toFixed6 | .objKeys | .objValues | .objEntries => true
  | .plus | .minus | .tilde | .typeof | .voidOp | .toBigInt
  | .mathFloor | .mathCeil | .mathTrunc | .mathRound | .mathAbs | .mathSign => false

/-- Is this binary opcode a primitive method rather than an operator? -/
def BinOp.isPrimMethod : BinOp → Bool
  | .strSplit | .strIndexOf | .strLastIndexOf | .strSliceFrom | .strCharAt
  | .strAt | .strCodePointAt => true
  | _ => false

/-- Is this boolean opcode a primitive method rather than an operator? -/
def BinOpBool.isPrimMethod : BinOpBool → Bool
  | .strIncludes | .strStartsWith | .strEndsWith => true
  | _ => false

/-- Is this type a possible receiver of a fold over a compiled Lean value? -/
def JSTy.canBeLeanValue : JSTy → Bool
  | .leanEnum | .object => true
  | _                   => false

mutual

/-- Collect *every* statically detectable error, in source order. -/
def Expr.check {n : Nat} : Expr n js g → List OptError
  | .var _ | .unsafeGlobal _ _ | .numLit _ | .bigintLit _ | .str _ | .undefined | .null => []
  | .bexpr b     => BExpr.check b
  | .obj props   => ObjProps.check props
  | .arr elems   => ExprList.check elems
  | .prop o name =>
      (match o.checkTy with
       | some .undefined => [.nullishProp .undefined name.val]
       | some .null      => [.nullishProp .null name.val]
       | _               => []) ++ Expr.check o
  | .index o i   =>
      (match o.checkTy with
       | some .undefined => [.nullishProp .undefined "index"]
       | some .null      => [.nullishProp .null "index"]
       | _               => []) ++ Expr.check o ++ Expr.check i
  | .unary _ a   => Expr.check a
  | .binop _ a b => Expr.check a ++ Expr.check b
  | .cond c t e  => BExpr.check c ++ Expr.check t ++ Expr.check e
  | .leanEnum (.mk _ _ fields _) => ExprVec.check fields
  | .getField o idx =>
      (match o.checkTy with
       | some ty => if ty.canBeLeanValue then [] else [.nullishProp ty s!"_{idx + 1}"]
       | none    => []) ++ Expr.check o
  | .foldEnum fam scrut bs dflt =>
      (match scrut with
       | .leanEnum (.mk _ c _ _) =>
           if fam.allCtors.contains c then []
           else [.foldOfWrongFamily scrut.render c.name fam.name]
       | _ =>
         match scrut.checkTy with
         | some ty => if ty.canBeLeanValue then [] else [.foldOfNonValue scrut.render ty]
         | none    => []) ++ Expr.check scrut ++ Branches.check bs ++ Expr.check dflt
  | .foldArray dir a init body =>
      (match a.checkTy with
       | some .array => []
       | some ty     => [.foldOfNonArray a.render a.receiverNeedsParens dir.method ty]
       | none        => []) ++ Expr.check a ++ Expr.check init ++ Expr.check body
  | .letIn rhs body => Expr.check rhs ++ Expr.check body
  -- A join point and a jump are ordinary nodes for the checker: both children of a
  -- `jp` are checked, and so are the arguments of a jump.
  | .jp _ _ body k    => Expr.check body ++ Expr.check k
  | .jmp _ args     => ExprVec.check args
  -- The two inert nodes: the engine does not look inside a function or a call, so
  -- neither does the checker.  What a `lam` body contains has been checked where it
  -- was built (`LakeJs.Backend` optimises a body before it becomes one).
  | .funVal _ _ | .extApply _ _ => []
  -- A loop is an ordinary node for the checker: the initial values and the body are
  -- both checked, the body being a `TailExpr`.
  | .loop _ _ ini body => ExprVec.check ini ++ TailExpr.check body
termination_by e => e.size
decreasing_by all_goals (simp only [Expr.size, LeanEnum.size]; omega)

/-- Collect the statically detectable errors of a loop body. -/
def TailExpr.check {n k : Nat} : TailExpr n js g k → List OptError
  | .ret e      => Expr.check e
  | .next args  => ExprVec.check args
  | .ite c t e  => BExpr.check c ++ TailExpr.check t ++ TailExpr.check e
  | .bind rhs t => Expr.check rhs ++ TailExpr.check t
termination_by t => t.size
decreasing_by all_goals (simp only [TailExpr.size]; omega)

def BExpr.check {n : Nat} : BExpr n js g → List OptError
  | .tt | .ff     => []
  | .truthy e     => Expr.check e
  | .not c        => BExpr.check c
  | .and c d      => BExpr.check c ++ BExpr.check d
  | .or c d       => BExpr.check c ++ BExpr.check d
  | .binop _ a b  => Expr.check a ++ Expr.check b
  | .isArray e    => Expr.check e
  | .isTag o _    =>
      (match o.checkTy with
       | some .undefined => [.nullishProp .undefined "tag"]
       | some .null      => [.nullishProp .null "tag"]
       | _               => []) ++ Expr.check o
termination_by b => b.size
decreasing_by all_goals (simp only [BExpr.size]; omega)

def ExprList.check {n : Nat} : ExprList n js g → List OptError
  | .nil        => []
  | .cons e t   => Expr.check e ++ ExprList.check t
  | .spread e t =>
      (match e.checkTy with
       | some ty => if ty.isIterable then [] else [.spreadOfNonIterable e.render ty]
       | none    => []) ++ Expr.check e ++ ExprList.check t
termination_by l => l.size
decreasing_by all_goals (simp only [ExprList.size]; omega)

def ObjProps.check {n : Nat} : ObjProps n js g → List OptError
  | .nil            => []
  | .cons _ v t     => Expr.check v ++ ObjProps.check t
  | .computed k v t => Expr.check k ++ Expr.check v ++ ObjProps.check t
  | .spread s t     => Expr.check s ++ ObjProps.check t
termination_by ps => ps.size
decreasing_by all_goals (simp only [ObjProps.size]; omega)

def ExprVec.check {n k : Nat} : ExprVec n js g k → List OptError
  | .nil      => []
  | .cons h t => Expr.check h ++ ExprVec.check t
termination_by v => v.size
decreasing_by all_goals (simp only [ExprVec.size]; omega)

def Branches.check {fam : LeanRecFamily} {n : Nat} : Branches fam n js g → List OptError
  | .nil             => []
  | .cons _ _ body t => Expr.check body ++ Branches.check t
termination_by bs => bs.size
decreasing_by all_goals (simp only [Branches.size]; omega)

end


end
