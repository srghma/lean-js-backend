module

public import Lean.Data.Name

@[expose] public section

variable {js : List Nat}

/-!
# What a generated JavaScript file should contain

The compiler is always asked for a *file* together with a description of what that
file is for, and there are exactly two kinds of file it can produce:

* a **library**: a module that exports a non-empty list of declarations
  (`…code…` followed by `export {gcd};`), or
* a **program**: a module that runs `main` at the end.

The entry point is *always* the declaration called `main`, exactly as in a program
built by `lake`: there is no way to nominate another declaration, and `main` has to
have one of the types Lake accepts for it (`IO Unit`, `IO UInt32`,
`List String → IO Unit`, `List String → IO UInt32`) or compilation fails.

Both alternatives are non-empty by construction — `OnlyExports` carries a
`NonEmptyArray Name`, so "compile nothing and export nothing" cannot be requested —
and the set of roots the compiler starts from is read off the description, so nothing
unreachable is emitted.
-/

namespace Lean.Compiler.JS

/-- An array that is non-empty by construction. -/
structure NonEmptyArray (α : Type u) where
  /-- The first element. -/
  head : α
  /-- The remaining elements. -/
  tail : Array α := #[]
  deriving Repr, DecidableEq, Inhabited

namespace NonEmptyArray

def toArray (a : NonEmptyArray α) : Array α := #[a.head] ++ a.tail

def toList (a : NonEmptyArray α) : List α := a.toArray.toList

def size (a : NonEmptyArray α) : Nat := a.tail.size + 1

theorem size_pos (a : NonEmptyArray α) : 0 < a.size := Nat.succ_pos _

/-- `some` of the non-empty array with these elements, `none` if there are none. -/
def ofArray? (a : Array α) : Option (NonEmptyArray α) :=
  if h : 0 < a.size then some ⟨a[0], a.extract 1 a.size⟩ else none

def push (a : NonEmptyArray α) (x : α) : NonEmptyArray α := { a with tail := a.tail.push x }

end NonEmptyArray

/-- What a single output file should contain. -/
inductive OutputContent where
  /-- Only the given declarations and what they need, ending in
      `export {a, b, c};`. -/
  | onlyExports (names : NonEmptyArray Name)
  /-- Only what `main` needs, ending in a run of it. `main` must match Lake's
      specification for an entry point, or compilation fails. -/
  | onlyEntry
  deriving Repr, DecidableEq, Inhabited

namespace OutputContent

/-- The name of the entry point of a program: always `main`, as for `lake`. -/
def entryName : Name := `main

/-- The declarations compilation starts from. -/
def roots (c : OutputContent) : Array Name :=
  match c with
  | .onlyExports names => names.toArray
  | .onlyEntry => #[entryName]

/-- The entry point to run at the end of the file, if any. -/
def entry? (c : OutputContent) : Option Name :=
  match c with
  | .onlyExports _ => none
  | .onlyEntry => some entryName

/-- The declarations to export at the end of the file, if any. -/
def exports (c : OutputContent) : Array Name :=
  match c with
  | .onlyExports names => names.toArray
  | .onlyEntry => #[]

end OutputContent

/-! ## Reading the export list off the source file

A Lean file can say what its generated JavaScript should export with a comment at the
top:

```lean
-- @js_export: test1, test2, test3
```

A file without one exports every public declaration of its module.  The marker is
looked for only in the leading run of `--` comments and blank lines, so a comment in
the middle of the file cannot change what is exported.
-/

/-- Whitespace off both ends. -/
def trimS (s : String) : String := s.trimAscii.toString

/-- The marker that introduces the export list of a source file. -/
def exportMarker : String := "@js_export:"

/-- The names on an `@js_export: a, b, c` comment body. -/
def parseExportLine (body : String) : Array Name :=
  let rest : String := (body.drop exportMarker.length).toString
  (rest.splitOn ",").toArray.filterMap fun s =>
    let s : String := trimS s
    if s.isEmpty then none else some s.toName

/-- The export list of a source file, given its lines, if it declares one. -/
def exportsFromHeader : List String → Option (Array Name)
  | [] => none
  | line :: rest =>
    let l : String := trimS line
    if l.isEmpty then exportsFromHeader rest
    else if l.startsWith "--" then
      let body : String := trimS (l.drop 2).toString
      if body.startsWith exportMarker then some (parseExportLine body)
      else exportsFromHeader rest
    else none

/-- The export list of a source file, if it declares one. -/
def exportsFromSource (src : String) : Option (Array Name) :=
  exportsFromHeader (src.splitOn "\n")

/-- One output file and what it should contain. -/
structure OutputFileAndWhatItShouldContain where
  /-- The file to write, e.g. `gcd.js`. -/
  outputFile : String
  /-- What that file should contain. -/
  whatShouldContain : OutputContent
  deriving Repr, DecidableEq, Inhabited

end Lean.Compiler.JS

end
