module

public import LakeJs.Cli
public meta import LakeJs.Cli
public import LakeJs.Eval
public meta import LakeJs.Eval

@[expose] public section


/-!
# The test-suite of the JavaScript backend

Everything the backend does that is *not* IO is a pure function, and this file pins
it down with `#guard`s: the export-list comment, the command line, the primitive
dictionary of `LakeJs.JsPrims` (each primitive checked by running the optimizer on
it), and the rendering of a compiled declaration.

The end-to-end direction — a real `.olean` in, a `.js` file out — is
`scripts/js-snapshots.lean`, which needs IO and so cannot live here.
-/

namespace Lean.Compiler.JS

/-! ## The export list of a source file -/

#guard exportsFromSource "-- @js_export: test1, test2, test3\ndef test1 := 1" ==
  some #[`test1, `test2, `test3]

-- Blank lines and other comments before the marker are skipped.
#guard exportsFromSource "\n-- a comment\n--   @js_export:  a ,b\n\ndef a := 1" ==
  some #[`a, `b]

-- A file without the marker declares nothing, and the marker is only looked for in
-- the header: every public declaration is exported instead.
#guard exportsFromSource "def test1 := 1\n-- @js_export: test1" == none

-- A trailing separator does not produce an empty name.
#guard exportsFromSource "-- @js_export: a, b," == some #[`a, `b]

/-! ## The command line -/

/-- What a parsed command line asked for, as text, so that a test can pin it down. -/
def CliCommand.summary : CliCommand → String
  | .help => "--help"
  | .compile modules _ outputs =>
    String.intercalate " " (modules.toList.map toString) ++ " |" ++
      String.intercalate "" (outputs.toList.map fun o =>
        let what :=
          if o.whatShouldContain.entry?.isSome then "entry"
          else String.intercalate "," (o.whatShouldContain.exports.toList.map toString)
        s!" {o.outputFile}({what})")

/-- The summary of a command line that parses, and the error message otherwise. -/
def cliSummary (args : List String) : String :=
  match parseCli args with
  | .ok cmd => cmd.summary
  | .error e => "error: " ++ e

#guard cliSummary ["--help"] == "--help"
#guard cliSummary ["-h", "Foo.Bar"] == "--help"

#guard cliSummary ["-o", "out.js", "--export", "test1", "--export", "test2", "Foo.Bar"] ==
  "Foo.Bar | out.js(test1,test2)"

-- `--export=<decl>` is accepted too, and each `-o` starts a new file.
#guard cliSummary ["Foo", "-o", "a.js", "--export=x", "-o", "b.js", "--entry"] ==
  "Foo | a.js(x) b.js(entry)"

#guard cliSummary ["Foo", "-o", "a.js"] ==
  "error: output 'a.js': nothing to put in it (pass --export or --entry)"

#guard cliSummary ["Foo", "-o", "a.js", "--export", "x", "--entry"] ==
  "error: output 'a.js': --export and --entry cannot be combined"

#guard cliSummary ["-o", "a.js", "--export", "x"] == "error: no module given"

#guard cliSummary ["Foo"] ==
  "error: no output requested (pass -o FILE with --export or --entry)"

#guard cliSummary ["--export", "x"] == "error: --export must follow an --out"

#guard cliSummary ["Foo", "--wat"] == "error: unknown option '--wat'"

/-! ### The representation options

The knobs are global to a run, and the value of each is checked, so a typo is a
command-line error rather than a silent default. -/

/-- The configuration a command line asks for, as one line. -/
def cliConfig (args : List String) : String :=
  match parseCli args with
  | .ok (.compile _ cfg _) => cfg.describe
  | .ok .help => "--help"
  | .error e => "error: " ++ e

-- The defaults, when nothing is asked for.
#guard cliConfig ["Foo", "-o", "a.js", "--export", "x"] == JsConfig.default.describe

-- Each knob is read, `--flag=value` and `--flag value` alike.
#guard (match parseCli ["Foo", "-o", "a.js", "--export", "x", "--nat=bigint"] with
        | .ok (.compile _ cfg _) => cfg.natRepr == .bigint
        | _ => false)
#guard (match parseCli ["Foo", "-o", "a.js", "--export", "x", "--uint64", "num"] with
        | .ok (.compile _ cfg _) => cfg.uint64Repr == .num
        | _ => false)
#guard (match parseCli ["Foo", "-o", "a.js", "--export", "x", "--ctor=array",
                        "--fields=declared", "--enum=int", "--list=array",
                        "--char=codepoint", "--nat-sub-guard", "--divmod-guard"] with
        | .ok (.compile _ cfg _) =>
          cfg.ctorRepr == .positionalArray && cfg.fieldNaming == .declared &&
            cfg.enumRepr == .smallInt && cfg.listRepr == .jsArray &&
            cfg.charRepr == .codePoint && cfg.natSubGuard && cfg.divModZeroGuard
        | _ => false)

-- A preset sets everything at once, and a later option still wins.
#guard cliConfig ["Foo", "-o", "a.js", "--export", "x", "--preset=faithful"] ==
  JsConfig.presetFaithful.describe
#guard cliConfig ["Foo", "-o", "a.js", "--export", "x", "--preset=pbo"] ==
  JsConfig.presetPBO.describe
#guard (match parseCli ["Foo", "-o", "a.js", "--export", "x", "--preset=faithful",
                        "--nat=num"] with
        | .ok (.compile _ cfg _) => cfg.natRepr == .num && cfg.intRepr == .bigint
        | _ => false)

-- An unknown value of a knob is reported, with the values that are allowed.
#guard cliConfig ["Foo", "-o", "a.js", "--export", "x", "--nat=float"] ==
  "error: --nat: expected 'num' or 'bigint', got 'float'"
#guard cliConfig ["Foo", "-o", "a.js", "--export", "x", "--ctor=tuple"] ==
  "error: --ctor: expected 'object', 'array' or 'int', got 'tuple'"
#guard cliConfig ["Foo", "-o", "a.js", "--export", "x", "--preset=fast"] ==
  "error: --preset: expected 'default', 'pbo' or 'faithful', got 'fast'"
#guard cliSummary ["Foo", "-o", "a.js", "--export", "x", "--nat"] ==
  "error: missing argument for --nat"

/-! ## JavaScript names -/

#guard Backend.jsIdent `test1 == "test1"
#guard Backend.jsIdent `Array.append == "Array_append"
#guard Backend.jsIdent (Name.mkSimple "fn$p") == "fn$p"
#guard Backend.jsIdent (Name.mkSimple "2fast") == "_2fast"

/-! ## The primitive dictionary

Each primitive is applied to literals and run through `Expr.optimize`, so what is
pinned down is the *value* the generated JavaScript computes, not the shape of the
term — and each one is checked under **both** the default configuration (`Nat` and
`Int` as JavaScript numbers, no totality guards, `Char` a string) and the opposite
setting, since the configuration is what decides what the dictionary produces. -/

/-- The default configuration. -/
def cfgNum : JsConfig := {}

/-- Everything unbounded as a `BigInt`, every guard on, `Char` as its code point. -/
def cfgBig : JsConfig := JsConfig.presetFaithful

/-- The optimized rendering of a primitive applied to closed arguments. -/
def primStr (cfg : JsConfig) (declName : Name) (args : Array (JsExpr 0 [] ∅)) : String :=
  match jsPrim? cfg declName args with
  | some e => e.optimizeToString
  | none => "«unknown primitive»"

/-- The same, with one free variable, so that what is pinned down is the *shape* of
    the emitted code rather than a folded value.  The variable prints as `#0`. -/
def primShape (cfg : JsConfig) (declName : Name) (args : Array (JsExpr 1 [] ∅)) : String :=
  match jsPrim? cfg declName args with
  | some e => e.optimizeToString
  | none => "«unknown primitive»"

/-- A number literal argument. -/
def nl (i : Int) : JsExpr 0 [] ∅ := .numLit (JSNumber.ofInt i)

/-- A bigint literal argument. -/
def bi (i : Int) : JsExpr 0 [] ∅ := .bigintLit i

/-- The one free variable of a `primShape` test. -/
def xv : JsExpr 1 [] ∅ := .var ⟨0, by decide⟩

/-- A number literal, with room for `xv` beside it. -/
def nl1 (i : Int) : JsExpr 1 [] ∅ := .numLit (JSNumber.ofInt i)

/-- A bigint literal, with room for `xv` beside it. -/
def bi1 (i : Int) : JsExpr 1 [] ∅ := .bigintLit i

/-- `[7, 8]`, an array literal argument. -/
def sampleArr : JsExpr 0 [] ∅ := .arr (.cons (nl 7) (.cons (nl 8) .nil))

/-- `[7n, 8n]`, the same in the bigint configuration. -/
def sampleArrBig : JsExpr 0 [] ∅ := .arr (.cons (bi 7) (.cons (bi 8) .nil))

/-! ### `Nat` and `Int` -/

#guard primStr cfgNum ``Nat.add #[nl 2, nl 3] == "5"
#guard primStr cfgBig ``Nat.add #[bi 2, bi 3] == "5n"
#guard primStr cfgNum ``Nat.sub #[nl 5, nl 3] == "2"
#guard primStr cfgNum ``Nat.div #[nl 7, nl 2] == "3"
#guard primStr cfgNum ``Int.ofNat #[nl 7] == "7"
#guard primStr cfgNum ``Int.neg #[nl 7] == "-7"
#guard primStr cfgNum ``Int.sub #[nl 2, nl 5] == "-3"
#guard primStr cfgNum ``Int.natAbs #[nl (-5)] == "5"
#guard primStr cfgNum ``Int.toNat #[nl (-5)] == "0"
#guard primStr cfgNum ``Nat.repr #[nl 12] == "\"12\""

-- An integer division of numbers truncates with `Math.trunc`; a bigint division
-- truncates by itself.
#guard primShape cfgNum ``Nat.div #[xv, nl1 2] == "Math.trunc((#0 / 2))"
#guard primShape cfgBig ``Nat.div #[xv, bi1 2] == "(#0 / 2n)"
#guard primShape cfgBig ``Nat.div #[xv, xv] == "((#0 === 0n) ? 0n : (#0 / #0))"

-- A shift of an unbounded `Nat` is multiplication and division by a power of two in
-- the number representation: JavaScript's `<<` is 32-bit, Lean's `Nat.shiftLeft` is
-- not.
#guard primStr cfgNum ``Nat.shiftLeft #[nl 1, nl 40] == "1099511627776"
#guard primStr cfgNum ``Nat.shiftRight #[nl 1024, nl 3] == "128"

/-! ### The totality knobs -/

-- `Nat.sub`: the truncation guard is on by default, so underflow answers `0` as in
-- Lean; with the knob off the subtraction is a plain `-`.
#guard primStr cfgNum ``Nat.sub #[nl 2, nl 3] == "0"
#guard primStr { cfgNum with natSubGuard := false } ``Nat.sub #[nl 2, nl 3] == "-1"
#guard primShape cfgNum ``Nat.sub #[xv, nl1 1] == "((#0 < 1) ? 0 : (#0 - 1))"
#guard primShape { cfgNum with natSubGuard := false } ``Nat.sub #[xv, nl1 1] ==
  "(#0 - 1)"

-- The guard is not emitted where the operands rule underflow out: nothing is
-- subtracted, or both are literals and the result is non-negative.
#guard primShape cfgNum ``Nat.sub #[xv, nl1 0] == "(#0 - 0)"
#guard primStr cfgNum ``Nat.sub #[nl 5, nl 3] == "2"

-- Division and modulo by zero: Lean's `0` by default, JavaScript's answer with the
-- guard off.
#guard primStr cfgNum ``Nat.div #[nl 7, nl 0] == "0"
#guard primStr { cfgNum with divModZeroGuard := false } ``Nat.div #[nl 7, nl 0] ==
  "Infinity"
#guard primStr cfgNum ``Nat.mod #[nl 7, nl 0] == "0"

-- A literal divisor that cannot be zero costs nothing.
#guard primShape cfgNum ``Nat.div #[xv, nl1 2] == "Math.trunc((#0 / 2))"
#guard primShape cfgNum ``Nat.div #[xv, xv] ==
  "((#0 === 0) ? 0 : Math.trunc((#0 / #0)))"
#guard primStr cfgBig ``Nat.sub #[bi 2, bi 3] == "0n"
#guard primStr cfgBig ``Nat.div #[bi 7, bi 0] == "0n"

/-! ### The fixed-width types -/

-- `UInt8/16/32` and `Int8/16/32` are always numbers, and wrap exactly as Lean's do —
-- with the 32-bit bitwise operators, which is what makes the reduction foldable.
#guard primStr cfgNum ``UInt8.add #[nl 255, nl 1] == "0"
#guard primStr cfgNum ``UInt32.ofNat #[nl 4294967296] == "0"
#guard primStr cfgNum ``Int32.ofNat #[nl 2147483648] == "-2147483648"
#guard primStr cfgNum ``Int32.sub #[nl 2147483647, nl 1] == "2147483646"
#guard primStr cfgNum ``Int32.add #[nl (-2147483648), nl (-1)] == "2147483647"
#guard primStr cfgNum ``Int32.neg #[nl 2147483648] == "-2147483648"
#guard primStr cfgNum ``UInt32.toNat #[nl 65535] == "65535"
#guard primShape cfgNum ``UInt8.add #[xv, nl1 1] == "((#0 + 1) & 255)"
#guard primShape cfgNum ``Int8.add #[xv, nl1 1] == "(((#0 + 1) << 24) >> 24)"
#guard primShape cfgNum ``UInt32.add #[xv, nl1 1] == "((#0 + 1) >>> 0)"
#guard primShape cfgNum ``Int32.add #[xv, nl1 1] == "((#0 + 1) | 0)"

-- `UInt64`, `Int64` and `USize` follow their own knob, `BigInt` by default.
#guard primStr cfgNum ``UInt64.ofNat #[nl 5] == "5n"
#guard primStr cfgNum ``UInt64.add #[bi 5, bi 6] == "11n"
#guard primStr { cfgNum with uint64Repr := .num } ``UInt64.add #[nl 5, nl 6] == "11"

-- A number becomes a `BigInt` with `BigInt(x)`; there is no `Number(x)` in this
-- language, so the other direction is only compiled for a value that is known.
#guard primStr cfgNum ``UInt64.toNat #[bi 5] == "5"
#guard primShape cfgNum ``UInt64.toNat #[xv] == "«unknown primitive»"

-- An unsigned shift reduces its distance modulo the width, exactly as Lean's does;
-- a *signed* shift does not, and is deliberately not compiled.
#guard primStr cfgNum ``UInt32.shiftLeft #[nl 1, nl 31] == "2147483648"
#guard primStr cfgNum ``UInt32.shiftLeft #[nl 1, nl 32] == "1"
#guard primStr cfgNum ``UInt32.shiftRight #[nl 256, nl 4] == "16"
#guard primStr cfgNum ``Int8.shiftLeft #[nl 1, nl 1] == "«unknown primitive»"

/-! ### Strings, booleans, characters -/

#guard primStr cfgNum ``String.append #[.str "ab", .str "cd"] == "\"abcd\""
#guard primStr cfgNum ``Bool.xor #[.bexpr .tt, .bexpr .ff] == "true"
#guard primStr cfgNum ``Decidable.decide #[.bexpr .tt] == "true"
#guard primStr cfgNum ``Nat.decLt #[nl 1, nl 2] == "true"
#guard primStr cfgNum ``instDecidableEqString #[.str "a", .str "a"] == "true"
#guard primStr cfgNum ``String.decidableLT #[.str "a", .str "b"] == "true"
#guard primStr cfgNum ``String.decLE #[.str "b", .str "a"] == "false"
#guard primStr cfgNum ``String.isEmpty #[.str ""] == "true"
#guard primStr cfgNum ``Int.instDecidableEq #[nl 1, nl 1] == "true"

-- A `Char` is a one-character string, so `s.push c` is `s + c` and a comparison is
-- a string comparison.
#guard primStr cfgNum ``String.push #[.str "s", .str "w"] == "\"sw\""
#guard primStr cfgNum ``String.singleton #[.str "w"] == "\"w\""
#guard primStr cfgNum ``Char.instDecidableLt #[.str "a", .str "b"] == "true"
#guard primStr cfgNum ``instDecidableEqChar #[.str "a", .str "b"] == "false"
#guard primStr cfgNum ``Char.ofNat #[nl 97] == "\"a\""
#guard primStr cfgNum ``Char.toNat #[.str "a"] == "97"

-- With `charRepr := .codePoint` a `Char` is its code point, which is what Lean's own
-- compiler does; `Char.ofNat` answers `'\0'` on a lone surrogate.
#guard primStr cfgBig ``Char.toNat #[bi 97] == "97n"
#guard primStr cfgBig ``Char.ofNat #[bi 0xDC11] == "0n"
#guard primStr cfgBig ``Char.instDecidableLt #[bi 97, bi 98] == "true"

/-! ### `Float` and `Float32` -/

#guard primStr cfgNum ``Float.ofScientific #[nl 10, .bexpr .tt, nl 1] == "1"
#guard primStr cfgNum ``Float.ofScientific #[nl 25, .bexpr .tt, nl 2] == "0.25"
#guard primStr cfgNum ``Float.ofScientific #[nl 3, .bexpr .ff, nl 2] == "300"
#guard primStr cfgNum ``Float.add #[.numLit 1, .numLit 2] == "3"

-- A `Float32` operation is the plain double operation: **no** `Math.fround` after
-- it, deliberately.
#guard primShape cfgNum ``Float32.mul #[xv, nl1 2] == "(#0 * 2)"
#guard primShape cfgNum ``Float32.add #[xv, nl1 1] == "(#0 + 1)"

/-! ### Arrays -/

-- An `Array` is a JavaScript array, and `push`/`append` are spreads, which is what
-- lets the optimizer flatten a chain of them into one literal.
#guard primStr cfgNum ``Array.mkEmpty #[nl 4] == "[]"
#guard primStr cfgNum ``Array.push #[.arr (.cons (.str "a") .nil), .str "b"] ==
  "[\"a\", \"b\"]"
#guard primStr cfgNum ``Array.append
    #[.arr (.cons (.str "a") .nil), .arr (.cons (.str "b") .nil)] == "[\"a\", \"b\"]"

-- `a.size` is the JavaScript length when a `Nat` is a number, and `BigInt(a.length)`
-- when it is a bigint.
#guard primStr cfgNum ``Array.size #[sampleArr] == "2"
#guard primStr cfgBig ``Array.size #[sampleArrBig] == "2n"
#guard primShape cfgNum ``Array.size #[xv] == "#0.length"
#guard primShape cfgBig ``Array.size #[xv] == "BigInt(#0.length)"
#guard primStr cfgNum ``Array.isEmpty #[sampleArr] == "false"

-- Indexing through a `Fin`/proof is trusted: no check is emitted.  Indexing with `!`
-- always emits the bounds test, and out of range answers the `Inhabited` default.
#guard primShape cfgNum ``Array.getInternal #[xv, nl1 1] == "#0[1]"
#guard primStr cfgNum ``Array.get!Internal #[nl 0, sampleArr, nl 1] == "8"
#guard primStr cfgNum ``Array.get!Internal #[nl 0, sampleArr, nl 5] == "0"
#guard primShape cfgNum ``Array.get!Internal #[nl1 0, xv, nl1 5] ==
  "((5 < #0.length) ? #0[5] : 0)"

/-! ### `Int`'s Euclidean division, and the panics -/

-- `Int`'s `/` and `%` are *Euclidean*, and with the guard on `0` divides to `0`, as
-- in Lean.
#guard primStr cfgNum ``Int.ediv #[nl 7, nl 2] == "3"
#guard primStr cfgNum ``Int.ediv #[nl (-7), nl 2] == "-4"
#guard primStr cfgNum ``Int.ediv #[nl 7, nl (-2)] == "-3"
#guard primStr cfgNum ``Int.ediv #[nl (-7), nl (-2)] == "4"
#guard primStr cfgNum ``Int.ediv #[nl 5, nl 0] == "0"
#guard primStr cfgNum ``Int.emod #[nl (-7), nl 2] == "1"
#guard primStr cfgNum ``Int.emod #[nl 7, nl (-2)] == "1"
#guard primStr cfgNum ``Int.emod #[nl 5, nl 0] == "5"
#guard primStr cfgNum ``Int.fdiv #[nl (-7), nl 2] == "-4"
#guard primStr cfgNum ``Int.fmod #[nl (-7), nl 2] == "1"
#guard primStr cfgBig ``Int.ediv #[bi (-7), bi 2] == "-4n"

-- A panic returns the default value of its `Inhabited` argument, which is what
-- Lean's own `panic!` evaluates to.
#guard primStr cfgNum ``outOfBounds #[nl 3] == "3"
#guard primStr cfgNum ``panic #[.str "d", .str "msg"] == "\"d\""

-- A constant this backend has no primitive for is reported, never guessed.
#guard primStr cfgNum ``Array.foldl #[nl 1] == "«unknown primitive»"

/-! ## Rendering a compiled declaration -/

/-- `x => x + 1`, built by hand: the shape `Backend.convDecl` produces. -/
def sampleFun : Backend.JsFun [] ∅ :=
  { name := `test, jsName := "test", params := #["x"]
    body := .binop .plus (.var ⟨0, by decide⟩) (.numLit (JSNumber.ofNat 1)) }

-- A declaration that takes arguments is a function declaration, and the pretty
-- printer parenthesises from the precedence of the nodes, so no parentheses are
-- printed around `x + 1`.
#guard Backend.renderFun JsDataLayout.standard sampleFun ==
  "const test = (x) => x + 1;"

/-- A declaration that takes no argument is the value itself. -/
def sampleConst : Backend.JsFun [] ∅ :=
  { name := `k, jsName := "k", params := #[], body := .numLit (JSNumber.ofNat 1) }

#guard Backend.renderFun JsDataLayout.standard sampleConst == "const k = 1;"

/-! ## The `-Expr.txt` companion of a generated file -/

-- The entry of a declaration in the dump: its Lean name, its JavaScript name, how
-- its parameters are numbered, and its tree at one stage.
#guard Backend.dumpFun sampleFun ==
"=== test ===
js: test
parameters: #0 = x : unknown
(binop BinOp.plus
  (var #0)
  (num 1))
"

-- Every stage of the pipeline is printed, in the order the passes ran, and a stage
-- that changed nothing says so instead of repeating the tree.
#guard Backend.dumpFunTraced
    { fn := sampleFun, trace := { input := sampleFun.body, evaluated := sampleFun.body,
                                  shared := sampleFun.body } } ==
"=== test ===
js: test
parameters: #0 = x : unknown
-- input (translated from LCNF saveBase, before any pass)
(binop BinOp.plus
  (var #0)
  (num 1))
-- after Expr.optimize (the partial evaluator of LakeJs.Eval)
  (unchanged)
-- after Expr.cse (common-subexpression elimination, LakeJs.CSEDeep) — final
  (unchanged)
"

#guard Backend.renderParamLegend #[] (fun _ => Ty.unknown) == "parameters: none"
#guard Backend.renderParamLegend #["a", "b"] (fun _ => Ty.unknown) ==
  "parameters: #0 = a : unknown, #1 = b : unknown"

-- The legend shows what `saveBase` said about each hole, which is what the optimizer
-- was started from.
#guard Backend.renderParamLegend #["a", "b"]
    (fun i => if i.val == 0 then Ty.str else Ty.join Ty.nat Ty.undef) ==
  "parameters: #0 = a : string, #1 = b : nat|undefined"

/-! ## The type a hole is given, read off its LCNF type -/

-- A `Nat` is a number in the default configuration and a `BigInt` in the faithful
-- one; a hole of either type is *not* unknown, which is what makes the type-driven
-- rules of the engine fire.
#guard Backend.tyOfLCNFType JsConfig.default {} (.const ``Nat []) == Ty.nat
#guard Backend.tyOfLCNFType JsConfig.presetFaithful {} (.const ``Nat []) == Ty.bigint
#guard Backend.tyOfLCNFType JsConfig.default {} (.const ``Int []) == Ty.number
#guard Backend.tyOfLCNFType JsConfig.default {} (.const ``Bool []) == Ty.bool
#guard Backend.tyOfLCNFType JsConfig.default {} (.const ``String []) == Ty.str
#guard Backend.tyOfLCNFType JsConfig.default {} (.const ``Float []) == Ty.number
#guard Backend.tyOfLCNFType JsConfig.default {} (.const ``Char []) == Ty.str
#guard Backend.tyOfLCNFType JsConfig.presetFaithful {} (.const ``Char []) == Ty.bigint

-- An `Array α` is a JavaScript array whatever `α` is, and however it is applied.
#guard Backend.tyOfLCNFType JsConfig.default {}
  (.app (.const ``Array []) (.const ``Nat [])) == Ty.arr

-- What the translation cannot pin down it leaves unknown: a type variable, a
-- function type, an erased binder, a sort, and an inductive the `.olean` data says
-- nothing about.
#guard Backend.tyOfLCNFType JsConfig.default {} (.bvar 0) == Ty.unknown
#guard Backend.tyOfLCNFType JsConfig.default {}
  (.forallE `x (.const ``Nat []) (.const ``Nat []) .default) == Ty.unknown
#guard Backend.tyOfLCNFType JsConfig.default {} (.sort .zero) == Ty.unknown
#guard Backend.tyOfLCNFType JsConfig.default {} (.const `Foo.Bar []) == Ty.unknown

-- The trees go beside the file they describe; stdout gets no companion file.
#guard exprDumpFileFor "SnapshotsPBO/AssocIntOps.js" ==
  some "SnapshotsPBO/AssocIntOps-Expr.txt"
#guard exprDumpFileFor "out" == some "out-Expr.txt"
#guard exprDumpFileFor "-" == none

end Lean.Compiler.JS

end
