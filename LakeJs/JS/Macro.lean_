module Lean.JS.Macro

open Lean
open Lean.Parser

import Lean.JS.JsExpr

/-!
# JavaScript Macro

This module provides a macro for embedding JavaScript-like expressions directly in Lean,
which are then translated into the `Lean.JS.JsExpr` AST.
-/

declare_syntax_cat js_expr

syntax ident : js_expr
syntax num : js_expr
syntax str : js_expr
syntax js_expr " (" js_expr* ")" : js_expr
syntax js_expr "." ident : js_expr
syntax js_expr "[" js_expr "]" : js_expr
syntax js_expr " + " js_expr : js_expr
syntax js_expr " - " js_expr : js_expr
syntax js_expr " * " js_expr : js_expr
syntax js_expr " / " js_expr : js_expr
syntax js_expr " == " js_expr : js_expr
syntax js_expr " < " js_expr : js_expr
syntax js_expr " > " js_expr : js_expr
syntax js_expr " ? " js_expr " : " js_expr : js_expr
syntax "new " ident " (" js_expr* ")" : js_expr
syntax "[" js_expr* "]" : js_expr

/--
Elaborates a `js_expr` syntax node into a `Lean.JS.JsExpr` term.
-/
partial def elabJsExpr (s : TSyntax `js_expr) : TermElabM Expr := do
  match s with
  | `(js_expr | $id:ident) =>
      mkApp ``Lean.JS.JsExpr.identifier #[mkStrLit id.getId.getString!]
  | `(js_expr | $n:num) =>
      -- For simplicity, we treat all numbers as Nat. In a full impl, we'd handle floats.
      let val := n.getNat!
      mkApp ``Lean.JS.JsExpr.num #[mkNatLit val]
  | `(js_expr | $st:str) =>
      mkApp ``Lean.JS.JsExpr.str #[mkStrLit st.getString!]
  | `(js_expr | $fn:js_expr "(" $args:js_expr* ")") => do
      let fnExpr ← elabJsExpr fn
      let argsExprs ← args.mapM elabJsExpr
      mkAppN ``Lean.JS.JsExpr.call #[fnExpr, mkArrayLit argsExprs]
  | `(js_expr | $obj:js_expr "." $prop:ident) => do
      let objExpr ← elabJsExpr obj
      mkAppN ``Lean.JS.JsExpr.prop #[objExpr, mkStrLit prop.getId.getString!]
  | `(js_expr | $obj:js_expr "[" $idx:js_expr "]") => do
      let objExpr ← elabJsExpr obj
      let idxExpr ← elabJsExpr idx
      mkAppN ``Lean.JS.JsExpr.bracketAccess #[objExpr, idxExpr]
  | `(js_expr | $lhs:js_expr " + " $rhs:js_expr) => do
      let l ← elabJsExpr lhs
      let r ← elabJsExpr rhs
      mkAppN ``Lean.JS.JsExpr.binary #[mkApp ``Lean.JS.JsBinOp.add [], l, r]
  | `(js_expr | $lhs:js_expr " - " $rhs:js_expr) => do
      let l ← elabJsExpr lhs
      let r ← elabJsExpr rhs
      mkAppN ``Lean.JS.JsExpr.binary #[mkApp ``Lean.JS.JsBinOp.sub [], l, r]
  | `(js_expr | $lhs:js_expr " * " $rhs:js_expr) => do
      let l ← elabJsExpr lhs
      let r ← elabJsExpr rhs
      mkAppN ``Lean.JS.JsExpr.binary #[mkApp ``Lean.JS.JsBinOp.mul [], l, r]
  | `(js_expr | $lhs:js_expr " / " $rhs:js_expr) => do
      let l ← elabJsExpr lhs
      let r ← elabJsExpr rhs
      mkAppN ``Lean.JS.JsExpr.binary #[mkApp ``Lean.JS.JsBinOp.div [], l, r]
  | `(js_expr | $lhs:js_expr " == " $rhs:js_expr) => do
      let l ← elabJsExpr lhs
      let r ← elabJsExpr rhs
      mkAppN ``Lean.JS.JsExpr.binary #[mkApp ``Lean.JS.JsBinOp.eq [], l, r]
  | `(js_expr | $lhs:js_expr " < " $rhs:js_expr) => do
      let l ← elabJsExpr lhs
      let r ← elabJsExpr rhs
      mkAppN ``Lean.JS.JsExpr.binary #[mkApp ``Lean.JS.JsBinOp.lt [], l, r]
  | `(js_expr | $lhs:js_expr " > " $rhs:js_expr) => do
      let l ← elabJsExpr lhs
      let r ← elabJsExpr rhs
      mkAppN ``Lean.JS.JsExpr.binary #[mkApp ``Lean.JS.JsBinOp.gt [], l, r]
  | `(js_expr | $cond:js_expr " ? " $thenE:js_expr " : " $elseE:js_expr) => do
      let c ← elabJsExpr cond
      let t ← elabJsExpr thenE
      let e ← elabJsExpr elseE
      mkAppN ``Lean.JS.JsExpr.cond #[c, t, e]
  | `(js_expr | "new " $name:ident " (" $args:js_expr* ")") => do
      let argsExprs ← args.mapM elabJsExpr
      mkAppN ``Lean.JS.JsExpr.new #[mkStrLit name.getId.getString!, mkApp ``Option.some [mkArrayLit argsExprs]]
  | `(js_expr | "[" $elems:js_expr* "]") => do
      let elemsExprs ← elems.mapM elabJsExpr
      mkApp ``Lean.JS.JsExpr.arrayLiteral #[mkArrayLit elemsExprs]
  | _ => throwError "Invalid JS expression syntax"

/--
A macro that allows writing JS expressions directly in Lean and translates them to `JsExpr`.
Example: `js console.log("hello")`
-/
syntax "js " js_expr : term

elab "js " s:js_expr : term => do
  elabJsExpr s

end Lean.JS.Macro

-- #eval js console.log("hello")
-- #eval js 1 + 2
-- #eval js obj.prop
-- #eval js a ? b : c
-- #eval js [1, 2, 3]
